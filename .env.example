DISCORD_TOKEN=PEGAR_TOKEN_AQUI
GUILD_ID=ID_DEL_SERVIDOR
ENABLE_MESSAGE_LOGS=false

# Twitch automático
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=

# Opcional: ID de Discord de la streamer. Si queda 0, usa el rol 🎥・Streamer.
STREAMER_DISCORD_ID=0

# Cada cuántos segundos consultar Twitch. Mínimo recomendado: 30.
TWITCH_POLL_SECONDS=60

# Segundos que espera antes de borrar 🔴・stream-en-vivo al terminar.
TWITCH_OFFLINE_DELETE_DELAY=300
